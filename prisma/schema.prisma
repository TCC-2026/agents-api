generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id        String   @id @default(uuid())
  name      String   @unique
  apiKey    String   @unique @map("api_key")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("clients")
}

model Agent {
  id              String   @id @default(uuid())
  service         String   // Insight, Assistant, Categorization, Goal, Import
  modelName       String 
  modelVersion    String 
  fallbackAgentId String?  
  fallbackAgent   Agent?   @relation("AgentFallback", fields: [fallbackAgentId], references: [id])
  predecessors    Agent[]  @relation("AgentFallback")
  isActive        Boolean  @default(true)
  prompt          String   @db.Text
  temperature     Float    @default(0.7)
  maxTokens       Int      @default(150)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("agents")
}