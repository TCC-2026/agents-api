# Copie este arquivo para ".env" e preencha com os valores reais.
# Nunca commite o ".env" de verdade — ele já está no .gitignore.

# Servidor
PORT=3000
LOGGING=enabled                 # "disabled" silencia o LOGGER

# PostgreSQL (Prisma) — clientes, agentes, sessões e mensagens
# SSL é desativado automaticamente só se a URL contiver "localhost"
DATABASE_URL=postgresql://user:password@localhost:5432/agents_api

# Autenticação do endpoint administrativo (POST /api/v1/client)
ADMIN_PASS=defina-uma-senha-forte-aqui

# Firebase Admin SDK — acesso ao Cloud Firestore (dados financeiros do app)
# Cole aqui o JSON completo da service account, em uma única linha
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"..."}

# Google Cloud / Vertex AI — usado para acessar o Gemini com retenção zero
# Cole aqui o JSON completo da credencial do projeto GCP, em uma única linha
GCP_CREDENTIALS={"type":"service_account","project_id":"..."}
GCP_LOCATION=us-central1

# Modelos de IA (devem existir como linhas ativas na tabela "agents")
PRIMARY_INSIGHT_MODEL=gemini-2.5-flash
PRIMARY_ASSISTANT_MODEL=gemini-2.5-flash

# Twilio — canal WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=whatsapp:+14155238886
TWILIO_WEBHOOK_URL=https://seu-dominio.com/api/v1/agent/assistant/twilio

# Twilio — indicador de "digitando" (Public Beta)
# ATENÇÃO: são credenciais diferentes do Account SID / Auth Token acima.
# Gere em Twilio Console > Account > API keys & tokens > Create API key
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your-twilio-api-secret
